{
  "name": "markdown-ado-sync",
  "displayName": "Markdown ADO Sync",
  "description": "同步 Markdown 文件到 Azure DevOps Workitems",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-ado-sync.sync",
        "title": "同步所有",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "markdown-ado-sync.syncSingle",
        "title": "同步此工作项",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "markdown-ado-sync.configureScanPath",
        "title": "配置扫描路径"
      },
      {
        "command": "markdown-ado-sync.refresh",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "markdown-ado-sync.showLogs",
        "title": "显示同步日志"
      },
      {
        "command": "markdown-ado-sync.filterByState",
        "title": "按状态过滤",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "markdown-ado-sync.refresh",
          "when": "view == adoWorkitems",
          "group": "navigation"
        },
        {
          "command": "markdown-ado-sync.sync",
          "when": "view == adoWorkitems",
          "group": "navigation"
        },
        {
          "command": "markdown-ado-sync.filterByState",
          "when": "view == adoWorkitems && markdown-ado-sync:showFilterButton",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "markdown-ado-sync.syncSingle",
          "when": "view == adoWorkitems && viewItem == workitem",
          "group": "inline"
        }
      ]
    },
    "views": {
      "markdown-ado-sync": [
        {
          "type": "webview",
          "id": "adoWelcome",
          "name": "Welcome",
          "icon": "media/ado.svg",
          "when": "!markdown-ado-sync:authenticated || !markdown-ado-sync:allConfigured"
        },
        {
          "id": "adoWorkitems",
          "name": "ADO Workitems",
          "icon": "media/ado.svg",
          "when": "markdown-ado-sync:authenticated && markdown-ado-sync:allConfigured"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdown-ado-sync",
          "title": "Markdown ADO Sync",
          "icon": "media/ado.svg"
        }
      ]
    },
    "configuration": {
      "title": "Markdown ADO Sync",
      "properties": {
        "markdown-ado-sync.scanPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "要扫描的 Markdown 文件目录路径列表"
        },
        "markdown-ado-sync.debug": {
          "type": "boolean",
          "default": true,
          "description": "启用调试模式，显示更多日志信息"
        },
        "markdown-ado-sync.adoToken": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Personal Access Token"
        },
        "markdown-ado-sync.adoOrganization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps 组织名称"
        },
        "markdown-ado-sync.adoProject": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps 项目名称"
        },
        "markdown-ado-sync.processType": {
          "type": "string",
          "enum": ["Agile", "Scrum", "Basic", "CMMI"],
          "default": "Basic",
          "description": "Azure DevOps 流程类型"
        }
      }
    },
    "iconThemes": [
      {
        "id": "markdown-ado-sync-icons",
        "label": "Markdown ADO Sync Icons",
        "path": "./icons/icons.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "chokidar": "^4.0.3",
    "markdown-it": "^13.0.1",
    "uuid": "^11.0.3"
  }
}
